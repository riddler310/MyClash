香港手动场景=ssid, default=香港手动策略, cellular=香港手动策略, "ZTE-5G"=DIRECT, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png
台湾手动场景=ssid, default=台湾手动策略, cellular=台湾手动策略, "ZTE-5G"=DIRECT, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png
日本手动场景=ssid, default=日本手动策略, cellular=日本手动策略, "ZTE-5G"=DIRECT, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png
新加坡手动场景=ssid, default=新加坡手动策略, cellular=新加坡手动策略, "ZTE-5G"=DIRECT, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png
美国手动场景=ssid, default=美国手动策略, cellular=美国手动策略, "ZTE-5G"=DIRECT, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_States.png
香港自动场景=ssid, default=香港自动策略, cellular=香港自动策略, "ZTE-5G"=DIRECT, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png
