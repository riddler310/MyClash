[Rule]
# 1. 本地设备访问飞牛 NAS 时，按目标地址直连。
# 原 Mihomo 的 SRC-IP-CIDR,192.168.5.5/32 是匹配“来源地址”，不能等价照搬到 iOS Loon；此处按手机访问 NAS 的用途改为目标 IP 直连。
IP-CIDR,192.168.5.5/32,DIRECT,no-resolve

# 2. 局域网和保留地址直连
IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
IP-CIDR6,fc00::/7,DIRECT,no-resolve

# 3. 国内服务直连例外（对应源脚本中的少量显式直连规则）
DOMAIN,fsend.cn,DIRECT
DOMAIN,international-gfe.download.nvidia.com,DIRECT
DOMAIN-SUFFIX,epicgames.com,DIRECT
DOMAIN-SUFFIX,nvidia.cn,DIRECT
DOMAIN-SUFFIX,apple.cn,DIRECT
DOMAIN-SUFFIX,apple.com.cn,DIRECT
DOMAIN-SUFFIX,microsoft.cn,DIRECT
DOMAIN-SUFFIX,microsoft.com.cn,DIRECT

# 4. Loon 原生协议规则：尽量复刻源脚本“非中国流量阻止 QUIC”的意图。
# 这是按 GEOIP,CN 近似排除中国 IP；不再引用 Mihomo 专用的 MRS 规则集。
AND,((PROTOCOL,QUIC),(NOT,((GEOIP,CN)))),REJECT

# 5. 优先修正 Claude / Grok 路由，避免被 Anthropic / X(Twitter) 规则抢先匹配。
DOMAIN-SUFFIX,claude.ai,AI
DOMAIN-SUFFIX,claude.com,AI
DOMAIN-SUFFIX,anthropic.com,AI
DOMAIN-SUFFIX,grok.com,AI
DOMAIN-SUFFIX,grok.x.com,AI
DOMAIN-SUFFIX,x.ai,AI

# 6. NodeSeek（源脚本中的 NS 策略）
DOMAIN-SUFFIX,nodeseek.com,NS
DOMAIN-SUFFIX,nodeseek.org,NS
DOMAIN-SUFFIX,seek.li,NS
DOMAIN-SUFFIX,nodeimage.com,NS

# 7. Emby 辅助规则（源脚本中的显式规则）
DOMAIN-SUFFIX,mb3admin.com,Emby
DOMAIN-KEYWORD,emby,Emby

# 8. Meta 全系显式域名补充
DOMAIN-SUFFIX,facebook.com,Meta
DOMAIN-SUFFIX,fb.com,Meta
DOMAIN-SUFFIX,fbcdn.net,Meta
DOMAIN-SUFFIX,fbsbx.com,Meta
DOMAIN-SUFFIX,messenger.com,Meta
DOMAIN-SUFFIX,instagram.com,Meta
DOMAIN-SUFFIX,cdninstagram.com,Meta
DOMAIN-SUFFIX,whatsapp.com,Meta
DOMAIN-SUFFIX,whatsapp.net,Meta
DOMAIN-SUFFIX,threads.net,Meta
DOMAIN-SUFFIX,threads.com,Meta
DOMAIN-SUFFIX,meta.com,Meta
DOMAIN-SUFFIX,meta.ai,Meta

FINAL,漏网之鱼

[Remote Rule]
# 私网 / 广告 / GitHub 优先规则
https://kelee.one/Tool/Loon/Lsr/LAN_SPLITTER.lsr, policy=DIRECT, tag=LAN, enabled=true
https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Loon/Advertising/Advertising_Domain.list, policy=REJECT, tag=AdBlock, enabled=true
https://rule.kelee.one/Loon/GitHub.lsr, policy=默认代理, tag=GitHub, enabled=true

# AI（保留可莉 AI 规则，并在本地规则中明确 Claude / Grok）
https://kelee.one/Tool/Loon/Lsr/AI.lsr, policy=AI, tag=AI, enabled=true

# Media：统一进入 Media 策略组
https://rule.kelee.one/Loon/YouTube.lsr, policy=Media, tag=YouTube, enabled=true
https://rule.kelee.one/Loon/Netflix.lsr, policy=Media, tag=Netflix, enabled=true
https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Loon/HBO/HBO.list, policy=Media, tag=HBO, enabled=true
https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Loon/Twitch/Twitch.list, policy=Media, tag=Twitch, enabled=true
