Steam=select, 默认代理, 手动选择, 自动选择, 香港, 台湾, 日本, 新加坡, 美国, DIRECT, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Steam.png
TikTok=select, 台湾, 日本, 默认代理, 手动选择, 自动选择, 香港, 新加坡, 美国, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/TikTok.png
Twitter=select, 默认代理, 手动选择, 自动选择, 香港, 台湾, 日本, 新加坡, 美国, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Twitter.png
Emby=select, 默认代理, 手动选择, 自动选择, 香港, 台湾, 日本, 新加坡, 美国, DIRECT, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Emby.png
Spotify=select, 台湾, 默认代理, 手动选择, 自动选择, 香港, 日本, 新加坡, 美国, DIRECT, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png
