[Rule]
# 1. 局域网和保留地址直连（IP 直连请求；局域网域名由 LAN_SPLITTER 处理）
# 飞牛 NAS 192.168.5.5 已包含在 192.168.0.0/16 内（同时也在 bypass-tun 中），无需单独规则。
IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
IP-CIDR,192.168.0.0/16,DIRECT,no-resolve

# 2. 国内服务直连例外
DOMAIN,fsend.cn,DIRECT
DOMAIN,international-gfe.download.nvidia.com,DIRECT
DOMAIN-SUFFIX,epicgames.com,DIRECT
DOMAIN-SUFFIX,nvidia.cn,DIRECT
DOMAIN-SUFFIX,apple.cn,DIRECT
DOMAIN-SUFFIX,apple.com.cn,DIRECT
DOMAIN-SUFFIX,icloud.com.cn,DIRECT
DOMAIN-SUFFIX,microsoft.cn,DIRECT
DOMAIN-SUFFIX,microsoft.com.cn,DIRECT

# 3. 拦截非中国 IP 的 QUIC，强制回落 TCP
AND,((PROTOCOL,QUIC),(NOT,((GEOIP,CN)))),REJECT

# 4. 优先修正 Claude / Grok 路由，避免被 X(Twitter) 等规则抢先匹配
DOMAIN-SUFFIX,claude.ai,AI
DOMAIN-SUFFIX,claude.com,AI
DOMAIN-SUFFIX,anthropic.com,AI
DOMAIN-SUFFIX,grok.com,AI
DOMAIN-SUFFIX,grok.x.com,AI
DOMAIN-SUFFIX,x.ai,AI

# 5. NodeSeek
DOMAIN-SUFFIX,nodeseek.com,NS
DOMAIN-SUFFIX,nodeseek.org,NS
DOMAIN-SUFFIX,seek.li,NS
DOMAIN-SUFFIX,nodeimage.com,NS
DOMAIN-SUFFIX,nodequality.com,NS

# 6. 金融与加密货币补充规则（Bybit / 币安 / OKX / Bitget / TradingView / 海外港美股券商与支付）
